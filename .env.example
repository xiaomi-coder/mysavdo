# MyBazzar — muhit o'zgaruvchilari
#
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# `.env` git ga tushmaydi (.gitignore da bor) — kalitlarni hech kimga bermang.
#
# Qiymatlarni qayerdan olish:
#   Supabase → Project Settings → API
#     Project URL      → REACT_APP_SUPABASE_URL
#     anon / public key → REACT_APP_SUPABASE_ANON_KEY

REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
